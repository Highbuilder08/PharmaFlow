# ============================================================
# PharmaFlow 환경변수 예시
# ============================================================
#
# 이 파일에는 실제 비밀번호, Secret Key, API Key 등을 작성하지 않습니다.
# 실제 환경값은 .env 또는 운영 환경의 Secret 관리 기능을 통해 주입합니다.
#
# Docker Compose 사용 시:
#   cp .env.example .env
# 이후 .env의 placeholder 값을 개발환경에 맞게 변경합니다.
#
# .env 파일은 Git에 커밋하지 않습니다.


# ============================================================
# Django 기본 설정
# ============================================================

# Django 암호화에 사용하는 Secret Key
# 실제 환경에서는 충분히 길고 예측하기 어려운 값을 사용
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# 개발 환경: True
# 운영 환경: False
DJANGO_DEBUG=True

# 접속을 허용할 호스트를 쉼표로 구분
#
# 일반 개발환경 예:
#   127.0.0.1,localhost
#
# Docker Compose 개발환경 예:
#   localhost,127.0.0.1,django,nginx
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost


# ============================================================
# MariaDB 데이터베이스 설정
# ============================================================

# 사용할 데이터베이스 이름
DB_NAME=pharmaflow

# 애플리케이션에서 사용할 데이터베이스 계정
DB_USER=pharmaflow_user

# 데이터베이스 계정 비밀번호
DB_PASSWORD=replace-with-db-password

# 데이터베이스 서버 주소
#
# 일반 로컬 개발환경:
#   DB_HOST=127.0.0.1
#
# Docker Compose:
#   DB_HOST=db
#
# AWS 운영환경:
#   RDS Endpoint 사용
DB_HOST=127.0.0.1

# MariaDB 기본 포트
DB_PORT=3306

# Docker Compose의 MariaDB 컨테이너 초기화에 사용하는
# root 계정 비밀번호
#
# AWS RDS 운영환경의 Master Password와는 별개의 값이며,
# 실제 값은 .env에만 작성
MARIADB_ROOT_PASSWORD=replace-with-development-root-password


# ============================================================
# 건강보험심사평가원 API 설정
# ============================================================

# HIRA OpenAPI에서 발급받은 서비스 키
# 실제 인증키는 이 예시 파일이나 Git에 작성하지 않음
HIRA_SERVICE_KEY=


# ============================================================
# 이메일 발송 설정
# ============================================================
#
# 실제 SMTP 인증정보는 이 파일이나 Git에 작성하지 않습니다.
#
# Gmail SMTP:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#
# AWS SES:
#   EMAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
#   EMAIL_PORT=587
#
# Docker Compose 개발환경에서 실제 메일을 발송하지 않을 경우:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# 운영 SMTP 사용 시
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP 서버 주소
EMAIL_HOST=replace-with-smtp-host

# SMTP 포트
# STARTTLS: 587 / SSL: 465
EMAIL_PORT=587

# 587 사용 시 일반적으로 TLS=True, SSL=False
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# SMTP 인증 계정
EMAIL_HOST_USER=replace-with-smtp-user

# SMTP 인증 비밀번호
EMAIL_HOST_PASSWORD=replace-with-smtp-password

# 사용자에게 표시할 발신자
# 운영 예:
#   PharmaFlow <noreply@pharmaflow.homes>
DEFAULT_FROM_EMAIL=PharmaFlow <replace-with-sender-address>

# 비밀번호 재설정 링크 유효시간
# 1800초 = 30분
PASSWORD_RESET_TIMEOUT=1800


# ============================================================
# Gunicorn 설정
# ============================================================

# 일반 EC2 환경에서는 Nginx와 같은 호스트에서 접근하는 경우
# 127.0.0.1:8000 사용 가능
#
# Docker Compose에서는 별도 Nginx 컨테이너가 접근하므로:
#   GUNICORN_BIND=0.0.0.0:8000
GUNICORN_BIND=127.0.0.1:8000

# Gunicorn Worker 수
GUNICORN_WORKERS=3


# ============================================================
# Static 파일 설정
# ============================================================

# collectstatic 결과 저장 위치
#
# 일반 개발환경:
#   staticfiles
#
# 기존 AWS/EC2 운영환경 예:
#   /srv/pharmaflow/static
#
# Docker Compose:
#   /app/staticfiles
#
# Docker Compose에서는 static_data Volume을 통해
# Django /app/staticfiles와 Nginx /vol/static을 공유
STATIC_ROOT=staticfiles


# ============================================================
# Media 파일
# ============================================================
#
# Django의 기본 MEDIA_ROOT는 프로젝트 내부 media/입니다.
#
# Docker Compose에서는:
#   Django /app/media
#        ↕ media_data Volume
#   Nginx  /vol/media
#
# 현재 Django settings.py에서 MEDIA_ROOT를 별도 환경변수로
# 받지 않으므로 추가 환경변수는 필요하지 않습니다.


# ============================================================
# 로그 설정
# ============================================================

# Django 애플리케이션 로그 저장 디렉터리
#
# 일반 개발환경:
#   logs
#
# 기존 운영환경 예:
#   /var/log/pharmaflow
#
# Docker Compose:
#   /app/logs
#
# 컨테이너 자체 stdout/stderr 로그는 docker compose logs로 확인
LOG_DIR=logs

# 기록할 최소 로그 수준
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
