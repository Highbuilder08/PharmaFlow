# ============================================================
# Django 기본 설정
# ============================================================

# Django 암호화에 사용하는 비밀 키
# 운영 환경에서는 충분히 길고 예측하기 어려운 값으로 변경
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# 개발 환경: True
# 운영 환경: False
DJANGO_DEBUG=True

# 접속을 허용할 호스트를 쉼표로 구분해서 입력
# 예: 127.0.0.1,localhost,192.168.32.87,example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost


# ============================================================
# MariaDB 데이터베이스 설정
# ============================================================

# 사용할 데이터베이스 이름
DB_NAME=pharmaflow

# 데이터베이스 접속 계정
DB_USER=pharmaflow_user

# 데이터베이스 접속 비밀번호
DB_PASSWORD=replace-me

# 데이터베이스 서버 주소
# 같은 서버이면 127.0.0.1, 원격 서버이면 해당 서버 IP 입력
DB_HOST=127.0.0.1

# MariaDB 기본 포트
DB_PORT=3306


# ============================================================
# 건강보험심사평가원 API 설정
# ============================================================

# HIRA OpenAPI에서 발급받은 서비스 키
# 실제 인증키는 이 예시 파일에 작성하지 않음
HIRA_SERVICE_KEY=


# ============================================================
# 이메일 발송 설정
# ============================================================

# Django SMTP 이메일 백엔드
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP 서버
EMAIL_HOST=smtp.gmail.com

# TLS 방식의 SMTP 포트
EMAIL_PORT=587

# Gmail SMTP 587 포트 사용 시 TLS=True, SSL=False
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# 이메일 발송에 사용할 Gmail 계정
EMAIL_HOST_USER=your-email@gmail.com

# Gmail 계정의 일반 비밀번호가 아닌 Google 앱 비밀번호
EMAIL_HOST_PASSWORD=your-google-app-password

# 사용자가 받는 메일에 표시될 발신자
DEFAULT_FROM_EMAIL=PharmaFlow <your-email@gmail.com>

# 비밀번호 재설정 링크 유효시간(초)
# 1800초 = 30분
PASSWORD_RESET_TIMEOUT=1800


# ============================================================
# Gunicorn 설정
# ============================================================

# Gunicorn이 요청을 받을 주소와 포트
GUNICORN_BIND=127.0.0.1:8000

# Gunicorn 워커 프로세스 수
GUNICORN_WORKERS=3


# ============================================================
# 정적 파일 설정
# ============================================================

# collectstatic 산출물이 모이는 위치
# 비우거나 생략하면 프로젝트 내부 staticfiles/ 사용 (개발 환경 기본)
# 운영 서버 예시: /srv/pharmaflow/static  (Nginx가 서빙하는 경로 또는 공유 스토리지)
STATIC_ROOT=staticfiles


# ============================================================
# 로그 설정
# ============================================================

# Django 로그 파일을 저장할 디렉터리
# 운영 서버 예시: /var/log/pharmaflow
LOG_DIR=logs

# 기록할 최소 로그 수준
# DEBUG, INFO, WARNING, ERROR, CRITICAL 중 선택
LOG_LEVEL=INFO
